{
  "name": "ContactSubmission",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Customer name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the sender"
    },
    "phone": {
      "type": "string",
      "description": "Phone number of the sender"
    },
    "project_location": {
      "type": "string",
      "description": "Project location"
    },
    "service_required": {
      "type": "string",
      "description": "Required construction service"
    },
    "message": {
      "type": "string",
      "description": "Project details or enquiry message"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "site_visit_required",
        "quotation_sent",
        "won",
        "lost",
        "reviewed",
        "archived"
      ],
      "default": "new",
      "description": "Enquiry progress status"
    },
    "assigned_to": {
      "type": "string",
      "description": "Assigned team member"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "Next follow-up date"
    },
    "internal_notes": {
      "type": "string",
      "description": "Private admin notes about this enquiry"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}