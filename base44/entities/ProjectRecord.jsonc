{
  "name": "ProjectRecord",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string",
      "description": "Project name"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "main_contractor": {
      "type": "string",
      "description": "Main contractor name"
    },
    "location": {
      "type": "string",
      "description": "Project location"
    },
    "scope": {
      "type": "string",
      "description": "Scope of work"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "mobilised",
        "in_progress",
        "on_hold",
        "completed",
        "cancelled",
        "tender",
        "awarded",
        "mobilising",
        "closed"
      ],
      "default": "planning",
      "description": "Project status"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Completion percentage from 0 to 100"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Project start date"
    },
    "target_completion": {
      "type": "string",
      "format": "date",
      "description": "Expected completion date"
    },
    "contract_value": {
      "type": "number",
      "description": "Project value"
    },
    "project_manager": {
      "type": "string",
      "description": "Assigned supervisor"
    },
    "labour_team_assigned": {
      "type": "string",
      "description": "Labour or team assigned"
    },
    "daily_progress_notes": {
      "type": "string",
      "description": "Daily progress notes"
    },
    "site_photos_url": {
      "type": "string",
      "description": "Site photos URL"
    },
    "documents_url": {
      "type": "string",
      "description": "Project documents URL"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "part_paid",
        "paid",
        "overdue",
        "not_applicable"
      ],
      "default": "not_applicable",
      "description": "Payment status"
    },
    "notes": {
      "type": "string",
      "description": "Internal project notes"
    }
  },
  "required": [
    "project_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}