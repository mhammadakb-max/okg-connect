{
  "name": "CompanyUserMembership",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant/company ID"
    },
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "User email"
    },
    "user_name": {
      "type": "string",
      "description": "User name"
    },
    "role": {
      "type": "string",
      "enum": [
        "platform_owner",
        "platform_admin",
        "company_owner",
        "company_director",
        "operations_manager",
        "project_manager",
        "site_engineer",
        "site_supervisor",
        "accountant",
        "hr_admin",
        "document_controller",
        "sales_user",
        "worker",
        "client_viewer",
        "external_consultant",
        "subcontractor_viewer"
      ],
      "default": "company_owner",
      "description": "User role"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permission keys"
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "suspended",
        "removed"
      ],
      "default": "invited",
      "description": "Membership status"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Two-factor placeholder"
    },
    "last_login_at": {
      "type": "string",
      "description": "Last login timestamp"
    },
    "device_history": {
      "type": "string",
      "description": "Device login history placeholder"
    }
  },
  "required": [
    "company_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}